package main

import (
	"archive/tar"
	"fmt"
	"io"
	"log"
	"os"
	"path/filepath"
	"strings"
)

func main() {
	e := newExtractor(10, 10000)
	root := "D:\\projects\\GO\\harbor\\test\\nginx.tar"
	outDir, err := e.unpackRecursive(root)
	if err != nil {
		log.Fatalf("unpack failed: %v", err)
	}

	fmt.Println(outDir)
}

type Extractor struct {
	deep      int
	maxFiles  int
	extracted int
}

func newExtractor(deep, maxFiles int) *Extractor {
	return &Extractor{deep: deep, maxFiles: maxFiles}
}

func (e *Extractor) unpackRecursive(srcPath string) (string, error) {
	return e.unpackRecursiveDepth(srcPath, e.deep)
}

func (e *Extractor) unpackRecursiveDepth(srcPath string, depth int) (string, error) {
	info, err := os.Stat(srcPath)
	if err != nil {
		return "", err
	}
	if info.IsDir() {
		return srcPath, nil
	}

	if !isTarFile(srcPath) {
		return "", fmt.Errorf("unsupported file type: %s", srcPath)
	}

	outDir := strings.TrimSuffix(srcPath, filepath.Ext(srcPath))
	if outDir == srcPath {
		outDir = srcPath + "_unpacked"
	}

	if err := os.MkdirAll(outDir, 0o755); err != nil {
		return "", err
	}

	if err := e.unpackTarFile(srcPath, outDir); err != nil {
		return "", err
	}

	if depth <= 0 {
		return outDir, nil
	}

	if err := e.unpackNestedTars(outDir, depth-1); err != nil {
		return "", err
	}

	return outDir, nil
}

func (e *Extractor) unpackTarFile(srcPath, dstDir string) error {
	f, err := os.Open(srcPath)
	if err != nil {
		return err
	}
	defer f.Close()

	return e.unpackTarReader(f, dstDir)
}

func (e *Extractor) unpackTarReader(r io.Reader, dstDir string) error {
	tr := tar.NewReader(r)

	for {
		hdr, err := tr.Next()
		if err == io.EOF {
			return nil
		}
		if err != nil {
			return err
		}

		targetPath := filepath.Join(dstDir, filepath.Clean(hdr.Name))
		if !strings.HasPrefix(targetPath, dstDir+string(os.PathSeparator)) && targetPath != dstDir {
			return fmt.Errorf("archive contains invalid path: %s", hdr.Name)
		}

		switch hdr.Typeflag {
		case tar.TypeDir:
			if err := e.bumpFiles(1); err != nil {
				return err
			}
			if err := os.MkdirAll(targetPath, 0o755); err != nil {
				return err
			}
		case tar.TypeReg, tar.TypeRegA:
			if err := e.bumpFiles(1); err != nil {
				return err
			}
			if err := os.MkdirAll(filepath.Dir(targetPath), 0o755); err != nil {
				return err
			}

			out, err := os.Create(targetPath)
			if err != nil {
				return err
			}

			_, copyErr := io.Copy(out, tr)
			closeErr := out.Close()
			if copyErr != nil {
				return copyErr
			}
			if closeErr != nil {
				return closeErr
			}
		}
	}
}

func (e *Extractor) bumpFiles(n int) error {
	if e.maxFiles <= 0 {
		return nil
	}

	e.extracted += n
	if e.extracted > e.maxFiles {
		return fmt.Errorf("archive is too wide: extracted files limit exceeded (%d > %d)", e.extracted, e.maxFiles)
	}

	return nil
}

func (e *Extractor) unpackNestedTars(root string, depth int) error {
	return filepath.WalkDir(root, func(path string, d os.DirEntry, walkErr error) error {
		if walkErr != nil {
			return walkErr
		}
		if d.IsDir() {
			return nil
		}

		if !isTarFile(path) {
			return nil
		}

		nestedDir := strings.TrimSuffix(path, filepath.Ext(path))
		if nestedDir == path {
			nestedDir = path + "_unpacked"
		}

		if err := os.MkdirAll(nestedDir, 0o755); err != nil {
			return err
		}

		if err := e.unpackTarFile(path, nestedDir); err != nil {
			return fmt.Errorf("unpack nested tar %s: %w", path, err)
		}

		if depth <= 0 {
			return nil
		}

		return e.unpackNestedTars(nestedDir, depth-1)
	})
}

func isTarFile(path string) bool {
	return strings.EqualFold(filepath.Ext(path), ".tar")
}
